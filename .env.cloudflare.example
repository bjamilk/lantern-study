# Cloudflare Pages deploy (scripts/deploy-cloudflare-pages.ps1)
# Copy to .env.cloudflare — never commit .env.cloudflare
# Also set these as GitHub Actions secrets for CI previews — see docs/deploy/05-ci-cd-pipeline.md

# Create token: https://dash.cloudflare.com/profile/api-tokens
# Template: "Edit Cloudflare Workers" OR custom with:
#   Account → Cloudflare Pages → Edit
#   Account → Account Settings → Read
CLOUDFLARE_API_TOKEN=

# Optional — script auto-detects from GET /accounts if omitted
# Your account (from wrangler whoami): 825f1b169950dbd062df106b13586826
CLOUDFLARE_ACCOUNT_ID=

# Optional overrides written into Pages Production / Preview env (LANTERN_API_UPSTREAM)
# LANTERN_API_UPSTREAM_PRODUCTION=https://lantern-study-api.onrender.com
# LANTERN_API_UPSTREAM_PREVIEW=https://lantern-study-api-staging.onrender.com
