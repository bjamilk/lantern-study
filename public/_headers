/*
  https://developers.cloudflare.com/pages/configuration/headers/
  CSP is finalized at build time (see apps/web/scripts/inject-csp-headers.mjs).
*/

/*
  Global security headers (production). CSP mitigates XSS impact when JWT is in localStorage.
*/
/*
  /
    Cache-Control: no-cache, no-store, must-revalidate
    Content-Security-Policy: __CONTENT_SECURITY_POLICY__
    Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
    X-Content-Type-Options: nosniff
    X-Frame-Options: DENY
    Referrer-Policy: strict-origin-when-cross-origin
*/

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Security-Policy: __CONTENT_SECURITY_POLICY__
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

/*
  Content-Security-Policy: __CONTENT_SECURITY_POLICY__
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400

/assets/*
  Cache-Control: public, max-age=31536000, immutable
