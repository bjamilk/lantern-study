# ===========================================
# Lantern Study - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# Supabase Configuration
# ===========================================
VITE_SUPABASE_URL=http://127.0.0.1:55421
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
VITE_API_URL=http://localhost:3001

# ===========================================
# Mobile (Expo) — required for preview/production EAS builds
# ===========================================
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
EXPO_PUBLIC_API_URL=http://localhost:3001
# Optional LAN host for physical device dev (defaults to 127.0.0.1)
# EXPO_PUBLIC_LAN_API_HOST=192.168.1.100

# ===========================================
# API Server (see apps/api-server/.env.example for full list)
# ===========================================
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# REDIS_ENABLED=true
# REDIS_URL=redis://localhost:6379

# ===========================================
# Google OAuth
# ===========================================
# Get credentials from: https://console.cloud.google.com/apis/credentials
# 1. Create a new OAuth 2.0 Client ID
# 2. Add authorized redirect URI: http://localhost:54321/auth/v1/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===========================================
# Apple Sign In (Supabase Auth)
# ===========================================
# 1. Apple Developer: enable Sign in with Apple on App ID com.lanternstudy.app
# 2. Create a Services ID for web OAuth (this becomes APPLE_CLIENT_ID)
# 3. Create a Sign in with Apple key (.p8) and generate client secret JWT
# 4. In Supabase Dashboard → Auth → Apple: add bundle IDs for native iOS
#    (com.lanternstudy.app, com.lanternstudy.app.dev)
# Secret JWT expires every 6 months — regenerate and update SUPABASE_AUTH_EXTERNAL_APPLE_SECRET
APPLE_CLIENT_ID=your-apple-services-id
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=your-apple-client-secret-jwt

# ===========================================
# OpenAI (for AI features)
# ===========================================
OPENAI_API_KEY=your-openai-api-key
