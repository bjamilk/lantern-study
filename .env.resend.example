# Resend SMTP for Supabase Auth — copy to .env.resend (never commit)
RESEND_API_KEY=

# From address: must use a domain verified in https://resend.com/domains
RESEND_FROM_EMAIL=noreply@lanternstudy.com
RESEND_SENDER_NAME=Lantern Study

# Contact form inbox (Cloudflare Email Routing or Google Workspace)
CONTACT_TO_EMAIL=support@lanternstudy.com
CONTACT_FROM_EMAIL=Lantern Study <noreply@lanternstudy.com>

# Supabase Management API (https://supabase.com/dashboard/account/tokens)
# Can also set SUPABASE_ACCESS_TOKEN in environment instead of here
SUPABASE_ACCESS_TOKEN=
