{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "downlevelIteration": true,
    "skipLibCheck": true,
    "declaration": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/types/**/*.ts",
    "src/utils/marketplaceBudget.ts",
    "src/utils/walletCoins.ts",
    "src/utils/marketplacePromo.ts",
    "src/utils/gamification.ts",
    "src/utils/testHelpers.ts",
    "src/utils/activity.ts",
    "src/utils/aiCredits.ts",
    "src/utils/aiUsage.ts",
    "src/utils/xp.ts",
    "src/utils/noteStudyContent.ts",
    "src/utils/smartNotes.ts",
    "src/utils/youtube.ts",
    "src/utils/photoNoteTitle.ts",
    "src/utils/srs.ts",
    "src/utils/fsrs.ts",
    "src/utils/server.ts",
    "src/utils/storageUrl.ts",
    "src/utils/apiMappers.ts",
    "src/utils/chatMedia.ts",
    "src/utils/chatMute.ts",
    "src/utils/dmHistoryCutoff.ts",
    "src/settings/**/*.ts",
    "src/network/**/*.ts",
    "src/marketplace/**/*.ts",
    "src/academic/**/*.ts",
    "src/learning/**/*.ts",
    "src/jobs/**/*.ts",
    "src/analytics/**/*.ts",
    "src/moderation/**/*.ts",
    "src/cookieConsent.ts",
    "src/accountLifecycle.ts",
    "src/contactForm.ts"
  ],
  "exclude": ["node_modules", "dist", "__tests__", "**/*.test.ts"]
}
