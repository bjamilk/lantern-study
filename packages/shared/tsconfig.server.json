{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "downlevelIteration": true,
    "skipLibCheck": true,
    "declaration": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/types/**/*.ts",
    "src/utils/marketplaceBudget.ts",
    "src/utils/walletCoins.ts",
    "src/utils/marketplacePromo.ts",
    "src/utils/gamification.ts",
    "src/utils/testHelpers.ts",
    "src/utils/activity.ts",
    "src/utils/aiUsage.ts",
    "src/utils/noteStudyContent.ts",
    "src/utils/srs.ts",
    "src/utils/fsrs.ts",
    "src/utils/server.ts",
    "src/utils/storageUrl.ts",
    "src/utils/apiMappers.ts",
    "src/settings/**/*.ts",
    "src/marketplace/**/*.ts",
    "src/accountLifecycle.ts",
    "src/contactForm.ts"
  ],
  "exclude": ["node_modules", "dist", "__tests__"]
}
