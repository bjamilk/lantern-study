{
  "name": "lantern-study",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@lantern/web",
    "dev:mobile": "turbo run dev --filter=@lantern/mobile",
    "dev:api": "turbo run dev --filter=@lantern/api-server",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@lantern/web",
    "build:mobile": "turbo run build --filter=@lantern/mobile",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "seo:notify": "node scripts/seo/notify-search-engines.mjs",
    "eas-build-pre-install": "node scripts/eas-prepare-mobile-install.js",
    "//postinstall": "`|| true` is required: apps/api-server/Dockerfile installs with `npm ci --omit=dev`, which excludes patch-package (a devDependency) while still running this hook. Without the guard the hook exits 127 and the Render image build fails. Patches only affect the mobile build, so skipping them in a production API install is correct.",
    "postinstall": "patch-package || true"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.15",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.19",
    "turbo": "^2.9.18",
    "typescript": "~5.8.2"
  },
  "packageManager": "npm@10.2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "react-native-reanimated": "3.19.5",
    "@types/express-serve-static-core": "5.1.0",
    "jws": "^4.0.1",
    "ws": "^8.21.0",
    "metro": {
      "ws": "^7.5.11"
    },
    "react-native": {
      "ws": "^6.2.4"
    },
    "@react-native/dev-middleware": {
      "ws": "^7.5.11"
    },
    "react-devtools-core": {
      "ws": "^7.5.11"
    },
    "rollup": "^4.59.0",
    "uuid": "^11.1.1",
    "lodash": "^4.17.24",
    "undici": "^6.27.0",
    "shell-quote": "^1.8.4",
    "minimatch": "^10.2.5",
    "@isaacs/brace-expansion": "^5.0.1",
    "brace-expansion": "^5.0.5",
    "picomatch": "^4.0.4",
    "form-data": "^4.0.6",
    "@xmldom/xmldom": "^0.9.10",
    "tar": "^7.5.16",
    "yaml": "^2.9.0",
    "qs": "^6.15.2",
    "path-to-regexp": "^8.4.2",
    "ip-address": "^10.2.0",
    "expo": {
      "postcss": "^8.5.15"
    },
    "diff": "^4.0.4",
    "@babel/core": "^7.29.1"
  },
  "dependencies": {
    "katex": "^0.16.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^6.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "semver": "^7.7.3"
  }
}
