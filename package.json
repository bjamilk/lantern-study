{
  "name": "lantern-study",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@lantern/web",
    "dev:mobile": "turbo run dev --filter=@lantern/mobile",
    "dev:api": "turbo run dev --filter=@lantern/api-server",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@lantern/web",
    "build:mobile": "turbo run build --filter=@lantern/mobile",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.19",
    "turbo": "^2.3.0",
    "typescript": "~5.8.2"
  },
  "packageManager": "npm@10.2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "react-native-reanimated": "~4.1.1",
    "react-native-worklets": "0.5.1"
  },
  "dependencies": {
    "katex": "^0.16.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^6.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^3.0.1",
    "remark-math": "^6.0.0",
    "semver": "^7.7.3"
  }
}
