{
  "name": "lantern-study",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@lantern/web",
    "dev:mobile": "turbo run dev --filter=@lantern/mobile",
    "dev:api": "turbo run dev --filter=@lantern/api-server",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@lantern/web",
    "build:mobile": "turbo run build --filter=@lantern/mobile",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "typecheck:root": "node scripts/check-web-typecheck.mjs",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "design:contrast": "node scripts/design/contrast.mjs",
    "seo:notify": "node scripts/seo/notify-search-engines.mjs",
    "eas-build-pre-install": "node scripts/eas-prepare-mobile-install.js",
    "//postinstall": "`|| true` is required: apps/api-server/Dockerfile installs with `npm ci --omit=dev`, which excludes patch-package (a devDependency) while still running this hook. Without the guard the hook exits 127 and the Render image build fails. Patches only affect the mobile build, so skipping them in a production API install is correct.",
    "//prepare": "Installs .husky/pre-commit (secret scan + mobile type-scale lint) by pointing git at that directory. `|| true` because npm runs `prepare` in contexts with no .git — a Docker build, `npm ci` from a tarball — and a failing hook install must never fail an install.",
    "prepare": "git config core.hooksPath .husky || true",
    "postinstall": "patch-package || true"
  },
  "devDependencies": {
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.5.0",
    "brace-expansion": "^5.0.5",
    "minimatch": "^10.2.5",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.19",
    "turbo": "^2.9.18",
    "typescript": "~5.8.2"
  },
  "packageManager": "npm@10.2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "react-native-reanimated": "3.19.5",
    "expo-asset": "~12.0.13",
    "@types/express-serve-static-core": "5.1.0",
    "jws": "^4.0.1",
    "ws": "^8.21.0",
    "metro": {
      "ws": "^7.5.11"
    },
    "react-native": {
      "ws": "^6.2.4"
    },
    "@react-native/dev-middleware": {
      "ws": "^7.5.11"
    },
    "react-devtools-core": {
      "ws": "^7.5.11"
    },
    "rollup": "^4.59.0",
    "uuid": "^11.1.1",
    "lodash": "^4.18.1",
    "undici": "^6.27.0",
    "shell-quote": "^1.8.4",
    "minimatch": "^10.2.5",
    "@isaacs/brace-expansion": "^5.0.1",
    "brace-expansion": "^5.0.5",
    "picomatch": "^4.0.4",
    "form-data": "^4.0.6",
    "@xmldom/xmldom": "^0.9.12",
    "tar": "^7.5.21",
    "yaml": "^2.9.0",
    "qs": "^6.15.2",
    "path-to-regexp": "^8.4.2",
    "ip-address": "^10.2.0",
    "expo": {
      "postcss": "^8.5.26"
    },
    "diff": "^4.0.4",
    "@babel/core": "^7.29.1",
    "@react-native/metro-config": {
      "ws": "^7.5.11"
    },
    "nanoid": "^3.3.18",
    "@expo/xcpretty": {
      "js-yaml": "^4.3.1"
    },
    "officeparser": {
      "pdfjs-dist": "^6.2.108"
    }
  },
  "dependencies": {
    "katex": "^0.16.8",
    "lucide-react": "1.41.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^6.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "semver": "^7.7.3"
  }
}
