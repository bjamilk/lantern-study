{
  "name": "@lantern/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/assert-prod-endpoints.mjs && node scripts/inject-sw-build-id.mjs && node scripts/inject-csp-headers.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest",
    "test:responsive": "playwright test -c playwright.config.ts",
    "test:preview-smoke": "playwright test -c playwright.config.ts e2e/preview-smoke.spec.ts",
    "audit:responsive": "node scripts/responsive-audit.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.6.0",
    "@heroicons/react": "^2.2.0",
    "@lantern/shared": "*",
    "@sentry/react": "^9.47.1",
    "@supabase/supabase-js": "^2.81.1",
    "chart.js": "^4.5.0",
    "matter-js": "^0.19.0",
    "pdfjs-dist": "^4.10.38",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^7.18.0",
    "uuid": "^11.1.1",
    "zustand": "5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.61.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^1.6.0"
  }
}
