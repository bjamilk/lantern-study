# IMPORTANT: when .easignore exists, EAS uses it INSTEAD of .gitignore.
# Keep both dependency ignores and local junk exclusions here.

# Dependencies & caches
node_modules/
.expo/
.expo-*/
.turbo/
.metro-health-check*

# Build outputs
dist/
web-build/
coverage/

# Native folders (local `expo prebuild` / run:android artifacts ~2GB)
/android
/ios
.kotlin/

# Local APKs / bundles that were bloating uploads to ~500MB
*.apk
*.aab
**/*.apk
**/*.aab

# Env / secrets
.env
.env.*
!.env.example

# Tests (not needed for native compile)
**/*.test.ts
**/*.test.tsx
**/__tests__/
**/*.spec.ts

# Tooling / scripts / logs
scripts/
*.log
.DS_Store
tmp/
*.pem
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.tsbuildinfo
npm-debug.*
yarn-debug.*
yarn-error.*
