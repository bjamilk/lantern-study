# IMPORTANT: when .easignore exists, EAS uses it INSTEAD of .gitignore.
# Paths are relative to this file (apps/mobile). EAS still archives the monorepo,
# so parent folders must be excluded with ../.. patterns.

# Dependencies & caches (local + monorepo root — root node_modules was ~2GB)
node_modules/
../../node_modules/
../web/
../api-server/
../../.turbo/
../../dist/
../../.migration-payloads/
../../docs/
.expo/
.expo-*/
.turbo/
.metro-health-check*

# Build outputs
dist/
web-build/
coverage/

# Native folders (local `expo prebuild` / run:android artifacts ~2GB)
android/
android/**
_android_local_bak/
_android_local_bak/**
ios/
ios/**
.kotlin/

# Local APKs / bundles that were bloating uploads to ~500MB
*.apk
*.aab
**/*.apk
**/*.aab

# Env / secrets
.env
.env.*
!.env.example

# Tests (not needed for native compile)
**/*.test.ts
**/*.test.tsx
**/__tests__/
**/*.spec.ts

# Tooling / scripts / logs
scripts/
*.log
.DS_Store
tmp/
*.pem
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.tsbuildinfo
npm-debug.*
yarn-debug.*
yarn-error.*
