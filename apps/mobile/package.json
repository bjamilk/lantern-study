{
  "name": "@lantern/mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "engines": {
    "node": ">=20.19.4 <21"
  },
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File ./scripts/start-expo-go.ps1",
    "start:go": "powershell -ExecutionPolicy Bypass -File ./scripts/start-expo-go.ps1",
    "start:go:tunnel": "powershell -ExecutionPolicy Bypass -File ./scripts/start-expo-go.ps1 -Tunnel",
    "start:go:script": "powershell -ExecutionPolicy Bypass -File ./scripts/start-expo-go.ps1",
    "start:go:tunnel:script": "powershell -ExecutionPolicy Bypass -File ./scripts/start-expo-go.ps1 -Tunnel",
    "start:offline": "expo start --offline",
    "android": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-emulator-network.ps1 && expo start --offline --android",
    "android:native": "expo run:android",
    "android:native-build": "powershell -ExecutionPolicy Bypass -File ./scripts/run-android-native-build.ps1",
    "android:emulator": "powershell -ExecutionPolicy Bypass -File ./scripts/run-emulator.ps1",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev": "node ./scripts/dev-client.js",
    "build:dev": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production --platform android",
    "update": "eas update --environment preview --platform android",
    "update:preview": "eas update --channel preview --environment preview --platform android",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "eas-build-pre-install": "node ../../scripts/eas-prepare-mobile-install.js"
  },
  "//postinstall": "The former postinstall ran scripts/ensure-expo-native-deps.js, which force-pinned react-native-worklets 0.5.1 for Expo Go. This app now uses Reanimated 3 with no worklets on the Legacy Architecture, so the pin is removed rather than run.",
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@lantern/shared": "*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.86.0",
    "expo": "~54.0.35",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-av": "~16.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.7",
    "expo-file-system": "~19.0.14",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "^0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.18",
    "expo-web-browser": "~15.0.11",
    "nativewind": "^4.2.6",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "^0.2.6",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-gifted-charts": "^1.4.52",
    "react-native-reanimated": "3.19.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-webview": "13.15.0",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.0.1",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  }
}
