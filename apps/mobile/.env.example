# API server (apps/api-server, default port 3001)
EXPO_PUBLIC_API_URL=http://127.0.0.1:3001

# Physical device on same Wi‑Fi — your computer's LAN IP (not 127.0.0.1)
EXPO_PUBLIC_LAN_API_HOST=192.168.1.100

