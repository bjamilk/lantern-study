{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@lantern/shared/utils/server": ["../../packages/shared/dist/utils/server"],
      "@lantern/shared/utils": ["../../packages/shared/dist/utils/index"],
      "@lantern/shared/utils/*": ["../../packages/shared/dist/utils/*"],
      "@lantern/shared/flashcards": ["../../packages/shared/dist/flashcards/index"],
      "@lantern/shared/flashcards/*": ["../../packages/shared/dist/flashcards/*"],
      "@lantern/shared/settings": ["../../packages/shared/dist/settings/index"],
      "@lantern/shared/settings/*": ["../../packages/shared/dist/settings/*"],
      "@lantern/shared/marketplace": ["../../packages/shared/dist/marketplace/index"],
      "@lantern/shared/network": ["../../packages/shared/dist/network/index"],
      "@lantern/shared/academic": ["../../packages/shared/dist/academic/index"],
      "@lantern/shared/chat": ["../../packages/shared/dist/chat/index"],
      "@lantern/shared/learning": ["../../packages/shared/dist/learning/index"],
      "@lantern/shared/jobs": ["../../packages/shared/dist/jobs/index"],
      "@lantern/shared/jobs/*": ["../../packages/shared/dist/jobs/*"],
      "@lantern/shared/analytics": ["../../packages/shared/dist/analytics/index"],
      "@lantern/shared/moderation": ["../../packages/shared/dist/moderation/index"],
      "@lantern/shared/notes": ["../../packages/shared/dist/notes/index"],
      "@lantern/shared/notes/*": ["../../packages/shared/dist/notes/*"],
      "@lantern/shared/study": ["../../packages/shared/dist/study/index"],
      "@lantern/shared/study/*": ["../../packages/shared/dist/study/*"],
      "@lantern/shared/groups": ["../../packages/shared/dist/groups/index"],
      "@lantern/shared/groups/*": ["../../packages/shared/dist/groups/*"],
      "@lantern/shared/types": ["../../packages/shared/dist/types/index"],
      "@lantern/shared/accountLifecycle": ["../../packages/shared/dist/accountLifecycle"],
      "@lantern/shared/contactForm": ["../../packages/shared/dist/contactForm"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
