{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@lantern/shared/utils": ["../../packages/shared/src/utils/index.ts"],
      "@lantern/shared/utils/*": ["../../packages/shared/src/utils/*"],
      "@lantern/shared/settings": ["../../packages/shared/src/settings/index.ts"],
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}