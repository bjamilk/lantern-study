# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Set to 'true' to allow token-less requests using a userId param in dev. Never set in production.
ALLOW_DEV_AUTH_BYPASS=false
# Never set in production — disables all rate limits
# DISABLE_RATE_LIMIT=false
# Never set in production — allows any CORS origin
# ALLOW_ALL_CORS=false

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Redis Configuration (required in production for shared rate limits across instances)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
# Production: use Upstash or similar — e.g. rediss://default:token@host:6379
REDIS_PASSWORD=

# GDPR retention jobs — purge AI logs/analytics after retention period (enable in production)
ENABLE_DATA_RETENTION_JOBS=false
AI_LOG_RETENTION_DAYS=90

# Protect /ready and /metrics in production (send as X-Operational-Token header)
# OPERATIONAL_ACCESS_TOKEN=your_random_token_here

# API Keys (DB-backed; use Authorization: Bearer lsk_... or X-API-Key: lsk_...)
API_KEY_SALT_ROUNDS=12
API_KEY_MAX_PER_USER=10
# Optional default expiry for new keys (0 = no expiry)
API_KEY_DEFAULT_TTL_DAYS=0

# Rate Limiting Configuration (see docs/deploy/03-api-hosting.md)
RATE_LIMIT_WINDOW_MS=900000
# Legacy alias for anonymous IP limit when ANON_IP_RATE_LIMIT_MAX is unset
RATE_LIMIT_MAX_REQUESTS=100
ANON_IP_RATE_LIMIT_MAX=300
PUBLIC_READ_RATE_LIMIT_MAX=120
PUBLIC_WRITE_RATE_LIMIT_MAX=10
API_KEY_AUTH_RATE_LIMIT_MAX=20
AUTHENTICATED_RATE_LIMIT_MAX=1200
AI_POST_BURST_MAX=15
UPLOAD_BURST_MAX=10
ADMIN_RATE_LIMIT_MAX=300

# Observability (optional)
# SENTRY_DSN=
# SENTRY_RELEASE=lantern-api@1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0.01
# AI_FETCH_TIMEOUT_MS=120000

# Logging Configuration
LOG_LEVEL=info

# Cache Configuration
CACHE_TTL_DEFAULT=300
CACHE_TTL_USER=600
CACHE_TTL_GROUP=600
CACHE_TTL_MESSAGE=120
CACHE_TTL_NOTIFICATION=120
CACHE_TTL_LEADERBOARD=300
CACHE_TTL_TEST_RESULTS=1800

# AI Provider Keys (at least one required for AI features)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
CF_ACCOUNT_ID=your_cloudflare_account_id_here
CF_API_TOKEN=your_cloudflare_api_token_here
HF_API_TOKEN=your_huggingface_api_token_here

# AI Rate Limiting
AI_DAILY_LIMIT=20

# YouTube note import (Supadata — https://supadata.ai)
# Required in production; dev falls back to youtube-transcript scrape when unset
SUPADATA_API_KEY=

# PowerPoint → PDF conversion (optional; recommended in production via Gotenberg sidecar)
# GOTENBERG_URL=http://localhost:3000

# Platform admin console — set true to allow in-app grant/revoke of platform admin role
ENABLE_ADMIN_ROLE_MANAGEMENT=false

# Saved-search match alerts + review reminders (runs on api-server interval)
# ENABLE_MARKETPLACE_JOBS=true
# MARKETPLACE_ALERTS_INTERVAL_MS=900000
# Estimated USD cost per AI analytics event (admin dashboard)
ADMIN_AI_EVENT_COST_USD=0.0025