# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
WEB_APP_URL=
# Comma-separated extra origins (optional)
# ALLOWED_ORIGINS=https://custom-preview.example.com
# Set to 'true' to allow token-less requests using a userId param in dev. Never set in production.
ALLOW_DEV_AUTH_BYPASS=false
# !!! NEVER set in production !!! — disables ALL rate limits (server refuses to boot with it in prod)
# DISABLE_RATE_LIMIT=false
# !!! NEVER set in production !!! — allows ANY CORS origin (server refuses to boot with it in prod)
# ALLOW_ALL_CORS=false

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Public anon key (RLS-governed) — used for auth routes (sign-in/refresh) and
# current-password verification during account deletion
SUPABASE_ANON_KEY=your_anon_key_here

# Security secrets
# Generic HMAC signing secret (also the fallback for EXPORT_SIGNING_SECRET)
# JWT_SECRET=
# Signs account-export download URLs (GDPR data export); falls back to JWT_SECRET
# EXPORT_SIGNING_SECRET=

# Redis Configuration (required in production for shared rate limits across instances)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
# Production: use Upstash or similar — e.g. rediss://default:token@host:6379
REDIS_PASSWORD=

# GDPR retention jobs — purge AI logs/analytics after retention period (enable in production)
ENABLE_DATA_RETENTION_JOBS=false
AI_LOG_RETENTION_DAYS=90

# Protect /ready and /metrics in production (send as X-Operational-Token header)
# OPERATIONAL_ACCESS_TOKEN=your_random_token_here

# Contact form (Resend) — requires domain verified at https://resend.com/domains
# RESEND_API_KEY=re_...
# Inbound mailbox for contact submissions (use Cloudflare Email Routing or Google Workspace)
CONTACT_TO_EMAIL=support@lanternstudy.com
CONTACT_FROM_EMAIL=Lantern Study <noreply@lanternstudy.com>
API_KEY_SALT_ROUNDS=12
API_KEY_MAX_PER_USER=10
# Optional default expiry for new keys (0 = no expiry)
API_KEY_DEFAULT_TTL_DAYS=0

# Rate Limiting Configuration (see docs/deploy/03-api-hosting.md)
RATE_LIMIT_WINDOW_MS=900000
# Legacy alias for anonymous IP limit when ANON_IP_RATE_LIMIT_MAX is unset
RATE_LIMIT_MAX_REQUESTS=100
ANON_IP_RATE_LIMIT_MAX=300
PUBLIC_READ_RATE_LIMIT_MAX=120
PUBLIC_WRITE_RATE_LIMIT_MAX=10
API_KEY_AUTH_RATE_LIMIT_MAX=20
AUTHENTICATED_RATE_LIMIT_MAX=1200
AI_POST_BURST_MAX=15
UPLOAD_BURST_MAX=10
ADMIN_RATE_LIMIT_MAX=300

# Observability (optional)
# SENTRY_DSN=
# SENTRY_RELEASE=lantern-api@1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0.01
# AI_FETCH_TIMEOUT_MS=120000
# Per-process AI concurrency (fail fast with 503 when saturated)
AI_MAX_INFLIGHT=16
COMPANION_STREAM_MAX=32
COMPANION_STREAM_TOKEN_DELAY_MS=0
# BullMQ worker concurrency (worker process only)
AI_WORKER_CONCURRENCY=4
FILE_WORKER_CONCURRENCY=1
EXPORT_WORKER_CONCURRENCY=1
# HTTP server tuning (0 max connections = unlimited; production defaults to 512)
HTTP_MAX_CONNECTIONS=512
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=66000
LOAD_SHED_HEAP_RATIO=0.92
# LOAD_SHED_RSS_BYTES=1610612736

# Logging Configuration
LOG_LEVEL=info

# Cache Configuration
CACHE_TTL_DEFAULT=300
CACHE_TTL_USER=600
CACHE_TTL_GROUP=600
CACHE_TTL_MESSAGE=120
CACHE_TTL_NOTIFICATION=120
CACHE_TTL_LEADERBOARD=300
CACHE_TTL_TEST_RESULTS=1800

# AI Provider Keys (at least one required for AI features)
GROQ_API_KEY=your_groq_api_key_here
# Optional Whisper fallback when Groq is down / rate-limited (lecture transcription)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
CF_ACCOUNT_ID=your_cloudflare_account_id_here
CF_API_TOKEN=your_cloudflare_api_token_here
HF_API_TOKEN=your_huggingface_api_token_here

# AI Rate Limiting
AI_DAILY_LIMIT=100
AI_LIMIT_COMPANION=75
AI_LIMIT_GENERATE_QUESTIONS=15
AI_LIMIT_GENERATE_FLASHCARDS=15
AI_LIMIT_EXPLAIN=40
AI_LIMIT_STUDY_PLAN=10
AI_LIMIT_ENHANCE_FLASHCARD=25
AI_LIMIT_STUDY_RECOMMENDATIONS=25

# YouTube transcript managed fallback (Supadata). Optional — without it, transcript
# fetching uses YouTube's free InnerTube API only, which may be IP-blocked on cloud hosts.
# Get a key at https://supadata.ai and set it to enable the fallback cascade.
# SUPADATA_API_KEY=sd_...

# PowerPoint → PDF conversion (required in production; never falls back to a public host)
# GOTENBERG_URL=http://localhost:3000
# Non-production only: ALLOW_PUBLIC_GOTENBERG_FALLBACK=true

# Local Smart Notes OCR (pdfjs page raster + @napi-rs/canvas + tesseract.js — no cloud OCR)
# Hard caps protect Render memory/CPU. Worker language data downloads on first OCR.
# NOTE_OCR_MAX_PDF_PAGES=15
# NOTE_OCR_MAX_SLIDES=20
# NOTE_PRESENTATION_OCR_TIMEOUT_MS=45000
# NOTE_PDF_OCR_TIMEOUT_MS=120000
# Soft AI credit cost when user manually triggers POST /notes/:id/ocr (0 disables)
# NOTE_OCR_CREDIT_COST=2

# Platform admin console — set true to allow in-app grant/revoke of platform admin role
ENABLE_ADMIN_ROLE_MANAGEMENT=false

# Saved-search match alerts + review reminders (runs on api-server interval)
# ENABLE_MARKETPLACE_JOBS=true
# MARKETPLACE_ALERTS_INTERVAL_MS=900000
# Estimated USD cost per AI analytics event (admin dashboard)
ADMIN_AI_EVENT_COST_USD=0.0025

# Paystack marketplace checkout (Nigeria). When enabled, buy-now/cart use Paystack;
# soft mark-paid / payment-link settlement is disabled for paid orders.
# MARKETPLACE_PAYSTACK_CHECKOUT=true
# MARKETPLACE_SERVICE_FEE_BPS=500
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_PUBLIC_KEY=pk_test_...
# Webhook URL: https://<api-host>/webhooks/paystack (HMAC via secret key)