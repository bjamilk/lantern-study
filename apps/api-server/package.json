{
  "name": "@lantern/api-server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "sync-schema": "echo Schema is in sync",
    "predev": "npm run build --workspace=@lantern/shared && npm run sync-schema",
    "prebuild": "npm run build --workspace=@lantern/shared",
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "worker:dev": "nodemon --exec ts-node src/worker.ts",
    "test": "jest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Scalable API server for Lantern Study app",
  "dependencies": {
    "@lantern/shared": "*",
    "@napi-rs/canvas": "^0.1.100",
    "@sentry/node": "^9.1.0",
    "@supabase/supabase-js": "^2.81.1",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.79.2",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.2",
    "libreoffice-convert": "^1.8.1",
    "lru-cache": "^11.2.2",
    "morgan": "^1.10.0",
    "officeparser": "^7.5.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.20.0",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.9.0",
    "sharp": "^0.35.3",
    "sql.js": "^1.12.0",
    "tesseract.js": "^7.0.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
